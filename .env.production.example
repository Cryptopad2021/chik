# ============================================================
# CHIRKEY TOUR — production-переменные (фаза 16.2, ТЗ §39/§51)
# Скопировать в .env на сервере РЯДОМ с docker-compose.prod.yml и заполнить.
# НИКОГДА не коммитить заполненный файл. Секреты — только из env.
# Policy: ротация JWT/Telegram-токенов каждые 90 дней; доступ к .env — только root/deploy-user (chmod 600).
# ============================================================

# ---- PostgreSQL (внутренний контейнер compose) ----
POSTGRES_USER=chirkey
POSTGRES_PASSWORD=CHANGE_ME_strong_random_32+
POSTGRES_DB=chirkey_tour

# ---- Домены (Caddy получит Let's Encrypt автоматически) ----
WEB_DOMAIN=chirkey.tour
ADMIN_DOMAIN=admin.chirkey.tour
NEXT_PUBLIC_API_URL=https://chirkey.tour/api
NEXT_PUBLIC_WEB_URL=https://chirkey.tour
MEDIA_PUBLIC_URL=https://chirkey.tour
# CORS: точный список публичных origin через запятую (не *)
CORS_ORIGINS=https://chirkey.tour,https://admin.chirkey.tour

# ---- Привязка портов (127.0.0.1 = наружу виден только Caddy на :80/:443) ----
API_BIND=127.0.0.1
WEB_BIND=127.0.0.1
ADMIN_BIND=127.0.0.1

# ---- Auth / JWT (минимум 32 случайных символа каждый; ротация 90 дней) ----
JWT_SECRET=CHANGE_ME_access_secret_min_32_random_chars
JWT_ACCESS_TTL=900
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_min_32_random_chars
JWT_REFRESH_TTL_DAYS=30

# ---- Telegram (ТЗ §31: токен ТОЛЬКО отсюда; выдать через BotFather) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=@chirkey_tour3
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME_random_secret
TELEGRAM_WEBHOOK_ENABLED=false
# Публичный HTTPS-URL API (для setWebhook при старте)
API_PUBLIC_URL=https://chirkey.tour
TELEGRAM_NOTIFICATIONS_ENABLED=true

# ---- Email (SMTP; пусто = dry-run, письма не отправляются) ----
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=no-reply@chirkey.tour

# ---- Redis (внутри стека; можно не менять) ----
# REDIS_URL задаётся в compose автоматически

# ---- Scheduler (cron-задачи: напоминания, публикация) ----
SCHEDULER_ENABLED=true

# ---- Media storage ----
# local: volume media:/data/media в контейнере api; s3: внешнее S3-совместимое хранилище
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# NOTE: SEED_DEMO в production НЕ используется — демо-данные в prod не сеются (ТЗ §50).
# Первый администратор создаётся вручную при деплое (см. docs/DEPLOYMENT.md, шаг 5).
