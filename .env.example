# ============================================================
# CHIRKEY TOUR — пример переменных окружения (ТЗ §51)
# Скопируйте в .env и заполните РЕАЛЬНЫМИ значениями.
# НИКОГДА не коммитьте .env с настоящими секретами (ТЗ §39).
# Все значения ниже — примеры-заглушки, не реальные credentials.
# ============================================================

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql://chirkey:chirkey@localhost:5432/chirkey_tour

# ---- Auth / JWT ----
JWT_SECRET=change-me-access-secret-min-32-chars
JWT_ACCESS_TTL=900
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_REFRESH_TTL_DAYS=30

# ---- API ----
API_PORT=3001
API_PREFIX=api
CORS_ORIGINS=http://localhost:3000,http://localhost:3002
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# ---- Public web / Admin ----
WEB_PORT=3000
ADMIN_PORT=3002
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3002

# ---- S3-compatible object storage (MinIO в dev) ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET=chirkey-media
S3_PUBLIC_BASE_URL=http://localhost:9000/chirkey-media

# ---- Telegram (только из env! ТЗ §31, §76) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=@chirkey_tour3
TELEGRAM_WEBHOOK_SECRET=change-me
TELEGRAM_WEBHOOK_ENABLED=false
TELEGRAM_NOTIFICATIONS_ENABLED=false

# ---- Email (SMTP; пустой = email-отправка выключена, dry-run) ----
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=no-reply@example.com

# ---- Redis (опционально: rate limit, очереди) ----
REDIS_URL=

# ---- Scheduler / cron (ТЗ §55; по умолчанию выключен в dev) ----
SCHEDULER_ENABLED=false

# ---- Feature flags ----
SEED_DEMO=true
