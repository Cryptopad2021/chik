# ЧиркейТур — reverse-proxy для production-стека (фаза 16.1/16.3).
# Замените домены на реальные; Caddy автоматически получит Let's Encrypt сертификаты.
# WEB_DOMAIN / ADMIN_DOMAIN подставляются из .env (docker compose env substitution).

{$WEB_DOMAIN:localhost} {
	encode zstd gzip
	handle_path /api/* {
		reverse_proxy api:3001
	}
	handle_path /media/* {
		reverse_proxy api:3001
	}
	reverse_proxy web:3000
}

{$ADMIN_DOMAIN:admin.localhost} {
	encode zstd gzip
	handle_path /api/* {
		reverse_proxy api:3001
	}
	reverse_proxy admin:3002
}
